[gd_scene format=3]

[ext_resource type="Script" path="res://workspace/authoring/authoring_workspace.gd" id="1"]

[node name="AuthoringWorkspace" type="HSplitContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
split_offset = 220
script = ExtResource("1")

[node name="Files" type="ItemList" parent="."]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Main" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Toolbar" type="HBoxContainer" parent="Main"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Open" type="Button" parent="Main/Toolbar"]
layout_mode = 2
text = "Open"

[node name="Init" type="Button" parent="Main/Toolbar"]
layout_mode = 2
text = "Init"

[node name="Save" type="Button" parent="Main/Toolbar"]
layout_mode = 2
text = "Save"

[node name="Validate" type="Button" parent="Main/Toolbar"]
layout_mode = 2
text = "Validate"

[node name="Scenes" type="Button" parent="Main/Toolbar"]
layout_mode = 2
tooltip_text = "Generate scene markdown from outline. Review the files before generating scripts."
text = "Scenes"

[node name="Scripts" type="Button" parent="Main/Toolbar"]
layout_mode = 2
tooltip_text = "Generate per-scene scripts after reviewing scene cards."
text = "Scripts"

[node name="Editor" type="TextEdit" parent="Main"]
layout_mode = 2
size_flags_vertical = 3
wrap_mode = 1

[node name="Status" type="Label" parent="Main"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Open or init an authoring directory."
text_overrun_behavior = 3

[node name="DirectoryDialog" type="FileDialog" parent="."]
title = "Open Authoring Directory"
ok_button_text = "Select"
file_mode = 2
access = 2
use_native_dialog = true
