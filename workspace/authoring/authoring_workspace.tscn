[gd_scene format=3]

[ext_resource type="Script" path="res://workspace/authoring/authoring_workspace.gd" id="1"]

[node name="AuthoringWorkspace" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="StepBar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Step0" type="Button" parent="StepBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "1. Outline"

[node name="Step1" type="Button" parent="StepBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "2. Scenes"

[node name="Step2" type="Button" parent="StepBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "3. Scripts"

[node name="Step3" type="Button" parent="StepBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "4. Review"

[node name="Step4" type="Button" parent="StepBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "5. IR"

[node name="StatusBanner" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2

[node name="StatusLabel" type="Label" parent="StatusBanner"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Open or init an authoring directory."
