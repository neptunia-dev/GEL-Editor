vertical_alignment = 1

[node name="Body" type="HSplitContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
split_offset = 200

[node name="Files" type="ItemList" parent="Body"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2

[node name="Editor" type="TextEdit" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
wrap_mode = 1

[node name="ActionBar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Open" type="Button" parent="ActionBar"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Open"

[node name="Init" type="Button" parent="ActionBar"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Init"

[node name="Save" type="Button" parent="ActionBar"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
